{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "types": ["vue-router/auto"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "layout/*": ["./src/layout/*"],
      "views/*": ["./src/views/*"],
      "stores/*": ["./src/stores/*"],
      "components/*": ["./src/components/*"],
      "composables/*": ["./src/composables/*"],
      "apis/*": ["./src/apis/*"],
      "assets/*": ["./src/assets/*"],
      "css/*": ["./src/css/*"],
      "boot/*": ["./src/boot/*"]
    }
  },
  "include": [
    "src/**/*",
    "types/**/*",
    "vite.config.ts"
  ]
}
