{
  "compilerOptions": {
    "allowJs": true,
    "noEmit": true,
    "ignoreDeprecations": "6.0",
    "target": "ESNext",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "jsx": "preserve",
    "importHelpers": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "sourceMap": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@common/api": ["packages/api/src/index.ts"],
      "@common/utils": ["packages/utils/src/index.ts"],
      "@common/form/*": ["packages/form/src/*"]
    }
  }
}
